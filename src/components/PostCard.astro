---
import { CATEGORIES } from '../config';
import { formatDate } from '../lib/posts';
interface Props { post: any; featured?: boolean }
const { post, featured = false } = Astro.props;
const { title, description, date, updated, category, image, imageAlt, rumor, pilar } = post.data;
const shown = pilar ? (updated ?? date) : date;
const href = `/${category}/${post.id}/`;
const src = image ?? `/img/portadas/${category}.webp`;
---
<article class:list={['card', { featured }]}>
  <a href={href} class="thumb" tabindex="-1" aria-hidden="true">
    <img src={src} alt={image ? (imageAlt ?? '') : ''} loading="lazy" width="1200" height="675" />
  </a>
  <div class="body">
    <div class="badges">
      <a class="tag" href={`/${category}/`}>{CATEGORIES[category].label}</a>
      {rumor && <span class="tag rumor">Rumor</span>}
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="muted">{description}</p>
    <span class="muted small">{pilar && 'Actualizado '}<time datetime={shown.toISOString()} data-rel>{formatDate(shown)}</time></span>
  </div>
</article>
<style>
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: transform .15s, border-color .15s; }
  .card:hover { transform: translateY(-3px); border-color: var(--pink); box-shadow: 0 0 24px #ff3fae33; }
  .thumb { display: block; aspect-ratio: 16/9; background: var(--surface-2); overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  h3 { margin: 4px 0 0; font-size: 1.3rem; }
  h3 a { color: var(--text); text-decoration: none; }
  p { margin: 0; font-size: .95rem; }
  time { margin-top: auto; }
  .featured { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .featured { flex-direction: row; }
    .featured .thumb { flex: 1.3; aspect-ratio: auto; min-height: 300px; }
    .featured .body { flex: 1; padding: 28px; justify-content: center; }
    .featured h3 { font-size: 2rem; }
  }
</style>
