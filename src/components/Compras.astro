---
// Caja "Dónde comprarlo" con enlaces de afiliado de Amazon. Solo aparece si hay amazonTag en config.ts.
import { SITE } from '../config';
interface Props { items: { nombre: string; busqueda: string; nota?: string }[] }
const { items } = Astro.props;
const tag = SITE.amazonTag;
const url = (q: string) => `https://www.amazon.es/s?k=${encodeURIComponent(q)}&tag=${encodeURIComponent(tag)}`;
---
{tag && items.length > 0 && (
  <aside class="compras" aria-labelledby="h-compras">
    <h2 id="h-compras">Dónde comprarlo</h2>
    <ul>
      {items.map((it) => (
        <li>
          <div><strong>{it.nombre}</strong>{it.nota && <span class="muted small"> · {it.nota}</span>}</div>
          <a class="btn" href={url(it.busqueda)} rel="sponsored nofollow noopener" target="_blank">Ver en Amazon</a>
        </li>
      ))}
    </ul>
    <p class="muted small">Enlaces de afiliado: como Afiliado de Amazon, obtenemos ingresos por las compras adscritas que cumplen los requisitos aplicables. A ti no te cuesta nada más.</p>
  </aside>
)}
<style>
  .compras { margin: 32px 0; padding: 18px 20px; border: 1px solid var(--teal); border-radius: var(--radius); background: #4cf2e60d; box-shadow: var(--glow-teal); }
  .compras h2 { margin: 0 0 10px; font-size: 1.5rem; }
  .compras ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .compras li { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .compras li:last-child { border-bottom: 0; }
  .btn { background: var(--pink); color: #14061a; font-weight: 800; text-decoration: none; padding: 8px 14px; border-radius: 999px; white-space: nowrap; box-shadow: var(--glow-pink); }
  .btn:hover { filter: brightness(1.1); }
</style>
