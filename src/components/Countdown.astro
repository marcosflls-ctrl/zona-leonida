---
import { SITE } from '../config';
---
<section class="countdown" data-target={SITE.launchDate} aria-label="Cuenta atrás para el lanzamiento de GTA VI">
  <p class="kicker">Lanzamiento de GTA VI<span class="sep"> · </span><span class="fecha">19 de noviembre de 2026</span></p>
  <div class="units">
    <div><span data-u="d">--</span><small>días</small></div>
    <div><span data-u="h">--</span><small>horas</small></div>
    <div><span data-u="m">--</span><small>min</small></div>
    <div><span data-u="s">--</span><small>seg</small></div>
  </div>
  <p class="done" hidden>¡GTA VI ya está disponible! Echa un vistazo a nuestras <a href="/guias/">guías</a> y <a href="/trucos/">trucos</a>.</p>
</section>
<script>
  const el = document.querySelector<HTMLElement>('.countdown');
  if (el) {
    const target = new Date(el.dataset.target!).getTime();
    const set = (u: string, v: number) => { const n = el.querySelector(`[data-u="${u}"]`); if (n) n.textContent = String(v).padStart(2, '0'); };
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) { el.querySelector('.units')?.setAttribute('hidden', ''); el.querySelector('.done')?.removeAttribute('hidden'); return; }
      set('d', Math.floor(diff / 864e5)); set('h', Math.floor(diff / 36e5) % 24);
      set('m', Math.floor(diff / 6e4) % 60); set('s', Math.floor(diff / 1e3) % 60);
      setTimeout(tick, 1000);
    };
    tick();
  }
</script>
<style>
  .countdown { border-radius: 20px; padding: 28px 20px; text-align: center; margin-bottom: 32px;
    background: radial-gradient(ellipse at 20% 130%, #ff3d8b66, transparent 60%), radial-gradient(ellipse at 85% -20%, #2de2c855, transparent 55%), linear-gradient(180deg, #2a1636, #17131f); border: 1px solid var(--line); }
  .kicker { margin: 0 0 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; color: var(--leaf); text-shadow: 0 0 10px #5dff8a66; }
  @media (max-width: 640px) { .countdown { padding: 20px 12px; margin-bottom: 28px; } .kicker .fecha { display: block; } .kicker .sep { display: none; } .kicker { letter-spacing: .08em; } }
  .units { display: flex; justify-content: center; gap: clamp(10px, 4vw, 36px); }
  .units div { display: flex; flex-direction: column; min-width: 62px; }
  .units span { font-family: Anton, sans-serif; font-size: clamp(2.4rem, 9vw, 4.4rem); line-height: 1; color: #ffe6f4; text-shadow: var(--glow-pink); }
  .units small { color: var(--muted); text-transform: uppercase; letter-spacing: .1em; font-size: .7rem; margin-top: 6px; }
  .done { font-size: 1.2rem; font-weight: 600; margin: 0; }
</style>
