---
import { SITE, CATEGORIES } from '../config';
import '@fontsource/anton/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-800.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  section?: string;
}
const { title, description, image, type = 'website', jsonLd, noindex = false, published, modified, section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// La marca solo se añade si cabe: Google corta los títulos a unos 60 caracteres
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : title.length > 47 ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
// tamaño real de la imagen para redes y Discover: portadas y fotos de artículos miden 1600x900; la genérica 1200x630
const ogSize = image ? (image.startsWith('/img/') ? [1600, 900] : null) : [1200, 630];
const year = new Date().getFullYear();
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={SITE.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
  {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
  {section && <meta property="article:section" content={section} />}
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.social.x && <meta name="twitter:site" content={`@${SITE.social.x}`} />}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0b0a12" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {SITE.cfAnalyticsToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${SITE.cfAnalyticsToken}"}`}></script>
  )}
  {SITE.adsenseClient && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  )}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="logo" aria-label={`${SITE.name}, inicio`}>
        <img class="logo-mark" src="/img/marca/logo-96.webp" alt="" width="30" height="30" /><span class="logo-text">{SITE.name}</span>
      </a>
      <a class="search-btn" href="/buscar/" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      <nav id="menu" aria-label="Secciones">
        {Object.entries(CATEGORIES).map(([key, c]) => (
          <a href={`/${key}/`} aria-current={path.startsWith(`/${key}/`) ? 'page' : undefined}>{c.label}</a>
        ))}
        <a href="/personajes/" aria-current={path.startsWith('/personajes/') ? 'page' : undefined}>Personajes</a>
        <a href="/trailers/" aria-current={path.startsWith('/trailers/') ? 'page' : undefined}>Tráilers</a>
        <a href="/imagenes-oficiales/" aria-current={path.startsWith('/imagenes-oficiales/') ? 'page' : undefined}>Imágenes</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div>
        <strong>{SITE.name}</strong>
        <p class="muted">Web de fans independiente. No está afiliada ni respaldada por Rockstar Games ni Take-Two Interactive. Grand Theft Auto y GTA son marcas de sus respectivos propietarios.</p>
      </div>
      <nav aria-label="Legal" class="footer-links">
        <a href="/sobre-nosotros/">Sobre nosotros</a>
        <a href="/contacto/">Contacto</a>
        <a href="/envia-tu-captura/">Envía tu captura</a>
        <a href="/politica-editorial/">Política editorial</a>
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="/cookies/">Cookies</a>
        {SITE.adsenseClient && <a href="#" id="gestionar-cookies">Gestionar cookies</a>}
        {SITE.social.x && <a href={`https://x.com/${SITE.social.x}`} rel="me noopener" target="_blank">X (Twitter)</a>}
        {SITE.social.telegram && <a href={`https://t.me/${SITE.social.telegram}`} rel="me noopener" target="_blank">Telegram</a>}
        {SITE.social.instagram && <a href={`https://www.instagram.com/${SITE.social.instagram}/`} rel="me noopener" target="_blank">Instagram</a>}
        {SITE.social.tiktok && <a href={`https://www.tiktok.com/@${SITE.social.tiktok}`} rel="me noopener" target="_blank">TikTok</a>}
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
    <p class="wrap muted small">© {year} {SITE.name}</p>
  </footer>
  <script is:inline>
    // Reabre el aviso de consentimiento de Google (Privacidad y mensajes de AdSense)
    (function () {
      var a = document.getElementById('gestionar-cookies');
      if (!a) return;
      a.addEventListener('click', function (e) {
        e.preventDefault();
        window.googlefc = window.googlefc || {};
        window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
        window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
      });
    })();
    (function () {
      // Vídeos de YouTube en guías: miniatura ligera que carga el vídeo (desde el segundo indicado) al pulsar
      document.querySelectorAll('figure.yt-guia[data-id]').forEach(function (f) {
        var id = f.getAttribute('data-id'), ini = f.getAttribute('data-inicio') || '0', autor = f.getAttribute('data-autor') || '';
        var seg = ini.split(':').reduce(function (a, b) { return a * 60 + (parseInt(b, 10) || 0); }, 0);
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'yt-btn'; b.setAttribute('aria-label', 'Reproducir vídeo' + (autor ? ' de ' + autor : ''));
        b.innerHTML = '<img src="https://i.ytimg.com/vi/' + id + '/hqdefault.jpg" alt="" loading="lazy" width="480" height="360"><span class="yt-play"></span>' + (seg ? '<span class="yt-ini">Desde ' + ini + '</span>' : '');
        b.addEventListener('click', function () {
          var fr = document.createElement('iframe');
          fr.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&start=' + seg;
          fr.title = 'Vídeo' + (autor ? ' de ' + autor : '');
          fr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; fr.allowFullscreen = true;
          b.replaceWith(fr);
        }, { once: true });
        f.insertBefore(b, f.firstChild);
        if (!f.querySelector('figcaption') && autor) {
          var c = document.createElement('figcaption');
          c.innerHTML = 'Vídeo: <a href="https://www.youtube.com/watch?v=' + id + (seg ? '&t=' + seg + 's' : '') + '" target="_blank" rel="noopener">' + autor + '</a> (YouTube)';
          f.appendChild(c);
        }
      });
    })();
    (function () {
      var btn = document.querySelector('.menu-btn'), nav = document.getElementById('menu');
      if (btn && nav) btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        nav.classList.toggle('open', open);
      });
    })();
    (function () {
      var now = Date.now();
      document.querySelectorAll('time[data-rel]').forEach(function (t) {
        var m = Math.round((now - new Date(t.getAttribute('datetime')).getTime()) / 6e4);
        if (m < 0 || m >= 1440) return;
        t.title = t.textContent;
        t.textContent = m < 1 ? 'hace un momento' : m < 60 ? 'hace ' + m + ' min' : 'hace ' + Math.round(m / 60) + (Math.round(m / 60) === 1 ? ' hora' : ' horas');
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0d0b14;
    --surface: #17131f;
    --surface-2: #211b2c;
    --text: #f3eef7;
    --muted: #a99db8;
    --pink: #ff3fae;
    --orange: #ff9a3d;
    --leaf: #5dff8a;
    --teal: #4cf2e6;
    --line: #2e2640;
    --sunset: linear-gradient(100deg, var(--pink), var(--teal));
    --glow-pink: 0 0 6px #ff3fae99, 0 0 18px #ff3fae55;
    --glow-teal: 0 0 6px #4cf2e699, 0 0 18px #4cf2e655;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 17px/1.65 Inter, system-ui, sans-serif;
  }
  a { color: var(--teal); }
  img { max-width: 100%; height: auto; }
  h1, h2, h3 { font-family: Anton, Impact, sans-serif; font-weight: 400; letter-spacing: .01em; line-height: 1.15; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(13,11,20,.88); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; position: relative; }
  .logo { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text); }
  .logo-mark { width: 30px; height: 30px; border-radius: 8px; display: block; box-shadow: 0 0 10px #ff3fae55; }
  .logo-text { font-weight: 800; letter-spacing: .01em; }
  .site-header nav { display: flex; gap: 2px; }
  .site-header nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem; padding: 8px 12px; border-radius: 999px; white-space: nowrap; }
  .site-header nav a:hover, .site-header nav a[aria-current] { color: var(--text); background: var(--surface-2); }
  .search-btn { order: 3; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--muted); border: 1px solid transparent; }
  .search-btn:hover { color: var(--text); background: var(--surface-2); }
  .menu-btn { display: none; width: 44px; height: 44px; padding: 11px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); cursor: pointer; flex-direction: column; justify-content: space-between; }
  .menu-btn span { display: block; height: 2px; border-radius: 2px; background: var(--text); transition: transform .2s, opacity .2s; }
  .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }
  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .search-btn { order: 0; margin-left: auto; border-color: var(--line); background: var(--surface); width: 44px; height: 44px; }
    .header-inner { gap: 10px; }
    .site-header nav { display: none; position: absolute; top: 100%; left: 0; right: 0; padding: 12px 16px 16px; background: rgba(13,11,20,.98); border-bottom: 1px solid var(--line); grid-template-columns: 1fr 1fr; gap: 8px; }
    .site-header nav.open { display: grid; }
    .site-header nav a:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .site-header nav a { font-size: 1rem; padding: 12px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); text-align: center; }
  }

  main { min-height: 70vh; padding-top: 24px; padding-bottom: 48px; }

  .site-footer { border-top: 1px solid var(--line); background: var(--surface); padding: 32px 0 16px; margin-top: 48px; }
  .footer-inner { display: grid; gap: 24px; grid-template-columns: 2fr 1fr; }
  .footer-links { display: flex; flex-direction: column; gap: 6px; }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--text); }
  .site-footer > .small { margin: 24px auto 0; padding-top: 16px; border-top: 1px solid var(--line); }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; gap: 12px; }
    .footer-links { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  }
  @media (max-width: 640px) { .grid { gap: 12px; } main { padding-top: 16px; } }

  .tag { display: inline-block; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; padding: 3px 10px; border-radius: 999px; background: var(--surface-2); color: var(--teal); text-decoration: none; }
  .tag.rumor { background: var(--orange); color: #12091a; }
  h1, h2 { text-shadow: 0 0 22px #ff3fae22; }
  .embed { margin: 1.6em 0; }
  .embed iframe { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: var(--radius); display: block; }
  .embed figcaption, .credit { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .prose { max-width: 720px; }
  .oficial { margin: 1.2em 0 1.6em; }
  .oficial img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); display: block; }
  .oficial figcaption { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .oficial-par { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .oficial-par figure { margin: 0; }
  .prose h2 { font-size: 1.8rem; margin-top: 2em; }
  .prose h3 { font-size: 1.35rem; margin-top: 1.6em; }
  .prose blockquote { border-left: 3px solid var(--pink); margin: 1.5em 0; padding: .2em 1em; color: var(--muted); }
  .prose table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; }
  @media (max-width: 640px) { .prose table { font-size: .85rem; } .prose th, .prose td { padding: 6px 7px; } }
  .prose code { background: var(--surface-2); padding: 2px 6px; border-radius: 6px; }
  .yt-guia { margin: 1.6em 0; }
  .yt-guia .yt-btn, .yt-guia iframe { position: relative; display: block; width: 100%; aspect-ratio: 16/9; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #000; cursor: pointer; }
  .yt-guia .yt-btn img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .9; }
  .yt-guia .yt-play { position: absolute; inset: 0; margin: auto; width: 72px; height: 72px; border-radius: 50%; background: var(--pink); box-shadow: var(--glow-pink); }
  .yt-guia .yt-play::after { content: ''; position: absolute; left: 29px; top: 22px; border-style: solid; border-width: 14px 0 14px 22px; border-color: transparent transparent transparent #fff; }
  .yt-guia .yt-ini { position: absolute; left: 10px; bottom: 10px; background: rgba(13,11,20,.85); color: var(--text); font-size: .8rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
  .yt-guia figcaption { font-size: .8rem; color: var(--muted); margin-top: 6px; }
  .breadcrumbs { font-size: .85rem; color: var(--muted); }
  .breadcrumbs a { color: var(--muted); }
</style>
