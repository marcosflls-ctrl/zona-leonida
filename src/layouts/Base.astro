---
import { SITE, CATEGORIES } from '../config';
import '@fontsource/anton/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-800.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  section?: string;
  lang?: 'es' | 'en';
  // Versiones del mismo contenido en otro idioma (rutas), para las etiquetas hreflang
  alternates?: { es?: string; en?: string };
}
const { title, description, image, type = 'website', jsonLd, noindex = false, published, modified, section, lang = 'es', alternates } = Astro.props;
const en = lang === 'en';
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// La marca solo se añade si cabe: Google corta los títulos a unos 60 caracteres
const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : title.length > 47 ? title : `${title} | ${SITE.name}`;
const ogImage = new URL(image ?? '/og-default.png', Astro.site).href;
// tamaño real de la imagen para redes y Discover: portadas y fotos de artículos miden 1600x900; la genérica 1200x630
const ogSize = image ? (image.startsWith('/img/') ? [1600, 900] : null) : [1200, 630];
const year = new Date().getFullYear();
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={en ? 'en' : SITE.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={en ? 'en_US' : SITE.locale} />
  {alternates?.es && <link rel="alternate" hreflang="es" href={abs(alternates.es)} />}
  {alternates?.en && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
  {alternates?.es && <link rel="alternate" hreflang="x-default" href={abs(alternates.es)} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  {ogSize && <meta property="og:image:width" content={String(ogSize[0])} />}
  {ogSize && <meta property="og:image:height" content={String(ogSize[1])} />}
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
  {section && <meta property="article:section" content={section} />}
  <meta name="twitter:card" content="summary_large_image" />
  {SITE.social.x && <meta name="twitter:site" content={`@${SITE.social.x}`} />}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#0b0a12" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {SITE.goatcounterCode && (
    <script async data-goatcounter={`https://${SITE.goatcounterCode}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
  )}
  {/* Sin anuncios en páginas noindex (por ejemplo, la galería de imágenes oficiales) */}
  {SITE.adsenseClient && !noindex && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  )}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href={en ? '/en/' : '/'} class="logo" aria-label={en ? `${SITE.name}, home` : `${SITE.name}, inicio`}>
        <img class="logo-mark" src="/img/marca/logo-96.webp" alt="" width="30" height="30" /><span class="logo-text">{SITE.name}</span>
      </a>
      {!en && <a class="search-btn" href="/buscar/" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </a>}
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
      {en ? (
      <nav id="menu" aria-label="Sections">
        <a href="/en/" aria-current={path === '/en/' ? 'page' : undefined}>GTA 6 guides</a>
        <a href={alternates?.es ?? '/'} lang="es">Español</a>
      </nav>
      ) : (
      <nav id="menu" aria-label="Secciones">
        {Object.entries(CATEGORIES).map(([key, c]) => (
          <a href={`/${key}/`} aria-current={path.startsWith(`/${key}/`) ? 'page' : undefined}>{c.label}</a>
        ))}
        <a href="/personajes/" aria-current={path.startsWith('/personajes/') ? 'page' : undefined}>Personajes</a>
        <a href="/trailers/" aria-current={path.startsWith('/trailers/') ? 'page' : undefined}>Tráilers</a>
        <a href="/imagenes-oficiales/" aria-current={path.startsWith('/imagenes-oficiales/') ? 'page' : undefined}>Imágenes</a>
        <a href={alternates?.en ?? '/en/'} lang="en">English</a>
      </nav>
      )}
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <a href={en ? '/en/' : '/'} class="logo footer-logo">
          <img class="logo-mark" src="/img/marca/logo-96.webp" alt="" width="36" height="36" loading="lazy" /><span class="logo-text">{SITE.name}</span>
        </a>
        <p class="footer-lema">{en ? 'GTA 6 news, guides and tips, with every source linked.' : 'Noticias, guías y trucos de GTA 6, con cada fuente enlazada.'}</p>
        <div class="footer-redes" aria-label={en ? 'Follow us' : 'Síguenos'}>
          {SITE.social.x && <a href={`https://x.com/${SITE.social.x}`} rel="me noopener" target="_blank" aria-label="X (Twitter)"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.8L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.8 3h6.3l4.4 5.9L17.8 3Zm-1.1 16.2h1.7L7.2 4.7H5.4l11.3 14.5Z"/></svg></a>}
          {SITE.social.telegram && <a href={`https://t.me/${SITE.social.telegram}`} rel="me noopener" target="_blank" aria-label="Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.6 19.9c-.2 1.1-.9 1.4-1.8.9l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.2-8.3c.4-.4-.1-.6-.6-.2L6 13.4l-4.9-1.5c-1.1-.3-1.1-1.1.2-1.6L20.5 3c.9-.3 1.7.2 1.4 1.3Z"/></svg></a>}
          {SITE.social.instagram && <a href={`https://www.instagram.com/${SITE.social.instagram}/`} rel="me noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm4.9-7.9a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2ZM12 3.6c2.7 0 3 0 4.1.1 2.7.1 4 1.4 4.1 4.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c-.1 2.7-1.4 4-4.1 4.1-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1.1-.1-1.4-.1-4.1s0-3 .1-4.1c.1-2.7 1.4-4 4.1-4.1 1.1-.1 1.4-.1 4.1-.1ZM12 2c-2.7 0-3.1 0-4.2.1C4.2 2.2 2.2 4.2 2.1 7.8 2 8.9 2 9.3 2 12s0 3.1.1 4.2c.1 3.6 2.1 5.6 5.7 5.7 1.1.1 1.5.1 4.2.1s3.1 0 4.2-.1c3.6-.1 5.6-2.1 5.7-5.7.1-1.1.1-1.5.1-4.2s0-3.1-.1-4.2c-.1-3.6-2.1-5.6-5.7-5.7C15.1 2 14.7 2 12 2Z"/></svg></a>}
          {SITE.social.tiktok && <a href={`https://www.tiktok.com/@${SITE.social.tiktok}`} rel="me noopener" target="_blank" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2-2.8V9.2a6.2 6.2 0 1 0 5.3 6.2V8.6a7.6 7.6 0 0 0 4.4 1.4V6.7a4.4 4.4 0 0 1-4.4-4.7Z"/></svg></a>}
          <a href="/rss.xml" aria-label="RSS"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 17a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm-2-7v3a8 8 0 0 1 8 8h3A11 11 0 0 0 3 10Zm0-6v3a14 14 0 0 1 14 14h3A17 17 0 0 0 3 4Z"/></svg></a>
        </div>
      </div>

      {en ? (
      <div class="footer-cols">
        <nav aria-label="Guides"><h2>Guides</h2>
          <a href="/en/gta-6-release-time/">Release time</a>
          <a href="/en/gta-6-preload/">Preload</a>
          <a href="/en/gta-6-game-pass-ps-plus/">Game Pass and PS Plus</a>
          <a href="/en/gta-6-file-size/">File size</a>
          <a href="/en/gta-6-price-editions/">Price and editions</a>
          <a href="/en/gta-6-gameplay-everything-confirmed/">Gameplay</a>
          <a href="/" lang="es">Versión en español</a>
        </nav>
        <nav aria-label="About"><h2>About</h2>
          <a href="/sobre-nosotros/">About us (in Spanish)</a>
          <a href="/contacto/">Contact</a>
          <a href="/politica-editorial/">Editorial policy (in Spanish)</a>
        </nav>
        <nav aria-label="Legal"><h2>Legal</h2>
          <a href="/aviso-legal/">Legal notice</a>
          <a href="/privacidad/">Privacy</a>
          <a href="/cookies/">Cookies</a>
          {SITE.adsenseClient && <a href="#" class="gestionar-cookies">Cookie settings</a>}
        </nav>
      </div>
      ) : (
      <div class="footer-cols">
        <nav aria-label="Secciones del pie"><h2>Secciones</h2>
          {Object.entries(CATEGORIES).map(([key, c]) => <a href={`/${key}/`}>{c.label}</a>)}
          <a href="/personajes/">Personajes</a>
          <a href="/trailers/">Tráilers</a>
          <a href="/imagenes-oficiales/">Imágenes oficiales</a>
          <a href="/mapa/">Mapa</a>
        </nav>
        <nav aria-label="Lo más consultado"><h2>Lo más consultado</h2>
          <a href="/guias/gta-6-a-que-hora-sale/">¿A qué hora sale GTA 6?</a>
          <a href="/guias/gta-6-precarga-como-descargar/">Cómo precargarlo</a>
          <a href="/guias/te-cabe-gta-6/">¿Te cabe GTA 6?</a>
          <a href="/guias/gta-6-precio-ediciones-reservas/">Precio y ediciones</a>
          <a href="/guias/gta-6-donde-comprar-mas-barato/">Dónde comprarlo más barato</a>
          <a href="/test-que-personaje-eres/">¿Qué personaje eres?</a>
        </nav>
        <nav aria-label="Zona Leonida"><h2>Zona Leonida</h2>
          <a href="/sobre-nosotros/">Sobre nosotros</a>
          <a href="/politica-editorial/">Política editorial</a>
          <a href="/envia-tu-captura/">Envía tu captura</a>
          <a href="/contacto/">Contacto</a>
          <a href={alternates?.en ?? '/en/'} lang="en">English</a>
        </nav>
        <nav aria-label="Legal"><h2>Legal</h2>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/privacidad/">Privacidad</a>
          <a href="/cookies/">Cookies</a>
          {SITE.adsenseClient && <a href="#" class="gestionar-cookies">Gestionar cookies</a>}
        </nav>
      </div>
      )}

      <div class="footer-bottom">
        <p>{en
          ? 'Independent fan site. Not affiliated with or endorsed by Rockstar Games or Take-Two Interactive. Grand Theft Auto and GTA are trademarks of their respective owners.'
          : 'Web de fans independiente. No está afiliada ni respaldada por Rockstar Games ni Take-Two Interactive. Grand Theft Auto y GTA son marcas de sus respectivos propietarios.'}</p>
        <p>© {year} {SITE.name}</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    // Reabre el aviso de consentimiento de Google (Privacidad y mensajes de AdSense)
    (function () {
      document.querySelectorAll('.gestionar-cookies').forEach(function (a) {
        a.addEventListener('click', function (e) {
          e.preventDefault();
          window.googlefc = window.googlefc || {};
          window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
          window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
        });
      });
    })();
    (function () {
      // Vídeos de YouTube en guías: miniatura ligera que carga el vídeo (desde el segundo indicado) al pulsar
      document.querySelectorAll('figure.yt-guia[data-id]').forEach(function (f) {
        var id = f.getAttribute('data-id'), ini = f.getAttribute('data-inicio') || '0', autor = f.getAttribute('data-autor') || '';
        var seg = ini.split(':').reduce(function (a, b) { return a * 60 + (parseInt(b, 10) || 0); }, 0);
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'yt-btn'; b.setAttribute('aria-label', 'Reproducir vídeo' + (autor ? ' de ' + autor : ''));
        b.innerHTML = '<img src="https://i.ytimg.com/vi/' + id + '/hqdefault.jpg" alt="" loading="lazy" width="480" height="360"><span class="yt-play"></span>' + (seg ? '<span class="yt-ini">Desde ' + ini + '</span>' : '');
        b.addEventListener('click', function () {
          var fr = document.createElement('iframe');
          fr.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&start=' + seg;
          fr.title = 'Vídeo' + (autor ? ' de ' + autor : '');
          fr.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; fr.allowFullscreen = true;
          b.replaceWith(fr);
        }, { once: true });
        f.insertBefore(b, f.firstChild);
        if (!f.querySelector('figcaption') && autor) {
          var c = document.createElement('figcaption');
          c.innerHTML = 'Vídeo: <a href="https://www.youtube.com/watch?v=' + id + (seg ? '&t=' + seg + 's' : '') + '" target="_blank" rel="noopener">' + autor + '</a> (YouTube)';
          f.appendChild(c);
        }
      });
    })();
    (function () {
      var btn = document.querySelector('.menu-btn'), nav = document.getElementById('menu');
      if (btn && nav) btn.addEventListener('click', function () {
        var open = btn.getAttribute('aria-expanded') !== 'true';
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        nav.classList.toggle('open', open);
      });
    })();
    (function () {
      var now = Date.now();
      document.querySelectorAll('time[data-rel]').forEach(function (t) {
        var m = Math.round((now - new Date(t.getAttribute('datetime')).getTime()) / 6e4);
        if (m < 0 || m >= 1440) return;
        t.title = t.textContent;
        t.textContent = m < 1 ? 'hace un momento' : m < 60 ? 'hace ' + m + ' min' : 'hace ' + Math.round(m / 60) + (Math.round(m / 60) === 1 ? ' hora' : ' horas');
      });
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0d0b14;
    --surface: #17131f;
    --surface-2: #211b2c;
    --text: #f3eef7;
    --muted: #a99db8;
    --pink: #ff3fae;
    --orange: #ff9a3d;
    --leaf: #5dff8a;
    --teal: #4cf2e6;
    --line: #2e2640;
    --sunset: linear-gradient(100deg, var(--pink), var(--teal));
    --glow-pink: 0 0 6px #ff3fae99, 0 0 18px #ff3fae55;
    --glow-teal: 0 0 6px #4cf2e699, 0 0 18px #4cf2e655;
    --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 17px/1.65 Inter, system-ui, sans-serif;
  }
  a { color: var(--teal); }
  img { max-width: 100%; height: auto; }
  h1, h2, h3 { font-family: Anton, Impact, sans-serif; font-weight: 400; letter-spacing: .01em; line-height: 1.15; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  .muted { color: var(--muted); }
  .small { font-size: .85rem; }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(13,11,20,.88); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; position: relative; }
  .logo { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--text); }
  .logo-mark { width: 30px; height: 30px; border-radius: 8px; display: block; box-shadow: 0 0 10px #ff3fae55; }
  .logo-text { font-weight: 800; letter-spacing: .01em; }
  .site-header nav { display: flex; gap: 2px; }
  .site-header nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem; padding: 8px 12px; border-radius: 999px; white-space: nowrap; }
  .site-header nav a:hover, .site-header nav a[aria-current] { color: var(--text); background: var(--surface-2); }
  .search-btn { order: 3; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--muted); border: 1px solid transparent; }
  .search-btn:hover { color: var(--text); background: var(--surface-2); }
  .menu-btn { display: none; width: 44px; height: 44px; padding: 11px 10px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); cursor: pointer; flex-direction: column; justify-content: space-between; }
  .menu-btn span { display: block; height: 2px; border-radius: 2px; background: var(--text); transition: transform .2s, opacity .2s; }
  .menu-btn[aria-expanded="true"] span:nth-child(1) { transform: translateY(9px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded="true"] span:nth-child(3) { transform: translateY(-9px) rotate(-45deg); }
  @media (max-width: 900px) {
    .menu-btn { display: flex; }
    .search-btn { order: 0; margin-left: auto; border-color: var(--line); background: var(--surface); width: 44px; height: 44px; }
    .header-inner { gap: 10px; }
    .site-header nav { display: none; position: absolute; top: 100%; left: 0; right: 0; padding: 12px 16px 16px; background: rgba(13,11,20,.98); border-bottom: 1px solid var(--line); grid-template-columns: 1fr 1fr; gap: 8px; }
    .site-header nav.open { display: grid; }
    .site-header nav a:last-child:nth-child(odd) { grid-column: 1 / -1; }
    .site-header nav a { font-size: 1rem; padding: 12px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); text-align: center; }
  }

  main { min-height: 70vh; padding-top: 24px; padding-bottom: 48px; }

  .site-footer { border-top: 1px solid var(--line); background: linear-gradient(180deg, var(--surface), #0b0a12); padding: 40px 0 20px; margin-top: 56px; position: relative; }
  .site-footer::before { content: ""; position: absolute; top: -1px; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, transparent, #ff3fae, #3fd9ff, transparent); opacity: .7; }
  .footer-top { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .footer-logo .logo-mark { width: 36px; height: 36px; }
  .footer-logo .logo-text { font-size: 1.2rem; }
  .footer-lema { margin: 0; color: var(--muted); flex: 1 1 260px; }
  .footer-redes { display: flex; gap: 8px; }
  .footer-redes a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--line); color: var(--muted); transition: color .15s, border-color .15s, box-shadow .15s; }
  .footer-redes a:hover { color: var(--text); border-color: #ff3fae; box-shadow: 0 0 12px #ff3fae44; }
  .footer-redes svg { width: 18px; height: 18px; }
  .footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; padding: 28px 0; }
  .footer-cols nav { display: flex; flex-direction: column; gap: 8px; }
  .footer-cols h2 { font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text); margin: 0 0 4px; font-weight: 700; }
  .footer-cols a { color: var(--muted); text-decoration: none; font-size: .95rem; }
  .footer-cols a:hover { color: var(--text); }
  .footer-bottom { border-top: 1px solid var(--line); padding-top: 16px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--muted); font-size: .8rem; }
  .footer-bottom p { margin: 0; max-width: 70ch; }
  @media (max-width: 720px) {
    .footer-cols { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
  }
  @media (max-width: 640px) { .grid { gap: 12px; } main { padding-top: 16px; } }

  .tag { display: inline-block; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; padding: 3px 10px; border-radius: 999px; background: var(--surface-2); color: var(--teal); text-decoration: none; }
  .tag.rumor { background: var(--orange); color: #12091a; }
  h1, h2 { text-shadow: 0 0 22px #ff3fae22; }
