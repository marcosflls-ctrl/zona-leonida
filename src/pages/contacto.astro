---
import Page from '../layouts/Page.astro';
const email = 'contacto@zonaleonida.com'; // ← cambia por tu correo
---
<Page title="Contacto" description="Contacta con la redacción: errores, sugerencias, colaboraciones y publicidad.">
  <p>¿Has encontrado un error, tienes un descubrimiento que compartir o quieres colaborar? Escríbenos a:</p>
  <p><a href={`mailto:${email}`}><strong>{email}</strong></a></p>
  <p>Intentamos responder en 48 horas.</p>
</Page>
