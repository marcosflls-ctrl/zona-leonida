---
import Base from '../layouts/Base.astro';
import Countdown from '../components/Countdown.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, CATEGORIES } from '../config';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const pilares = posts.filter((p) => p.data.pilar).sort((a, b) => a.data.orden - b.data.orden);
const feed = posts.filter((p) => !p.data.pilar);
const [first, ...rest] = feed;
// filas completas de 3 en escritorio (máx. 6 tarjetas bajo la destacada)
const latest = rest.slice(0, Math.min(6, Math.max(3, Math.floor(rest.length / 3) * 3)));
// lo que ya sale arriba no se repite en los bloques por categoría
const shown = new Set([...pilares, ...(first ? [first] : []), ...latest].map((p) => p.id));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'es',
  description: SITE.tagline,
};
---
<Base title={SITE.name} description="Noticias de GTA VI al día, guías completas, todos los trucos y los secretos descubiertos, en español." jsonLd={jsonLd}>
  <h1 class="sr-only">{SITE.name}: noticias, guías y trucos de GTA VI</h1>
  <picture class="hero">
    <source media="(max-width: 640px)" srcset="/img/marca/banner-movil.webp" />
    <img src="/img/marca/banner.webp" srcset="/img/marca/banner-1000.webp 1000w, /img/marca/banner.webp 2000w" sizes="(max-width: 1120px) 100vw, 1088px"
      alt="Cartel de neón de Zona Leonida en una calle mojada de noche: noticias, guías y trucos" width="2000" height="661" fetchpriority="high" />
  </picture>
  <Countdown />

  {pilares.length > 0 && (
    <section class="esencial" aria-labelledby="h-esencial">
      <h2 id="h-esencial" class="section-title">Lo esencial de GTA 6</h2>
      <ul class="esencial-list">
        {pilares.map((p) => (
          <li><a href={`/${p.data.category}/${p.id}/`}>
            <img src={p.data.image} alt="" width="160" height="90" loading="lazy" />
            <span>{p.data.title}</span>
          </a></li>
        ))}
      </ul>
    </section>
  )}

  {first && (
    <section aria-labelledby="h-latest">
      <h2 id="h-latest" class="section-title">Lo último</h2>
      <div class="grid">
        <PostCard post={first} featured />
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>
  )}

  <AdSlot />

  {Object.entries(CATEGORIES).map(([key, c]) => {
    const list = posts.filter((p) => p.data.category === key && !shown.has(p.id)).slice(0, 3);
    return list.length > 0 && (
      <section class="cat-block">
        <div class="cat-head">
          <h2 class="section-title">{c.label}</h2>
          <a href={`/${key}/`}>Ver todo →</a>
        </div>
        <div class="grid">{list.map((p) => <PostCard post={p} />)}</div>
      </section>
    );
  })}

  {posts.length === 0 && <p class="muted">Pronto publicaremos los primeros artículos.</p>}
</Base>
<style>
  .hero { display: block; margin: 0 0 20px; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 0 40px #ff3fae22; }
  .hero img { width: 100%; height: auto; display: block; }
  @media (max-width: 640px) { .hero img { aspect-ratio: 1159 / 851; object-fit: cover; } }
  .esencial { margin: 8px 0 44px; }
  .esencial-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(3, 1fr); }
  .esencial-list a { display: flex; flex-direction: column; gap: 8px; height: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; text-decoration: none; color: var(--text); font-weight: 700; font-size: .95rem; line-height: 1.3; transition: border-color .15s, box-shadow .15s; }
  .esencial-list a:hover { border-color: var(--teal); box-shadow: var(--glow-teal); }
  .esencial-list img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; display: block; }
  .esencial-list span { padding: 0 12px 12px; }
  @media (max-width: 900px) { .esencial-list { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .esencial-list { grid-template-columns: 1fr; gap: 10px; }
    .esencial-list a { flex-direction: row; align-items: center; gap: 12px; }
    .esencial-list img { width: 112px; flex: none; aspect-ratio: 16/10; }
    .esencial-list span { padding: 8px 12px 8px 0; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .section-title { font-size: 2rem; margin: 0 0 16px; }
  .cat-block { margin-top: 44px; }
  .cat-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .cat-head a { font-weight: 600; text-decoration: none; }
</style>
