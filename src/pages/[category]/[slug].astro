---
import fs from 'node:fs';
import HoraLocal from '../../components/HoraLocal.astro';
import { srcset } from '../../lib/img';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Compras from '../../components/Compras.astro';
import Compartir from '../../components/Compartir.astro';
import Siguenos from '../../components/Siguenos.astro';
import { CATEGORIES, SITE } from '../../config';
import { getPublishedPosts, formatDate, formatDateTime, readingTime, relacionados } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { category: post.data.category, slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const cat = CATEGORIES[d.category];
const url = `${SITE.url}/${d.category}/${post.id}/`;
const related = relacionados(post, all, 3);
// La portada en 16:9, 4:3 y 1:1 (si existen los recortes), como recomienda Google para Discover
const imagenesSchema = (src: string) => [src, src.replace(/\.webp$/, '-4x3.webp'), src.replace(/\.webp$/, '-1x1.webp')]
  .filter((s, i) => i === 0 || fs.existsSync(`public${s}`))
  .map((s) => new URL(s, SITE.url).href);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': d.category === 'noticias' ? 'NewsArticle' : 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    inLanguage: 'es',
    mainEntityOfPage: url,
    image: imagenesSchema(d.image ?? `/img/portadas/${d.category}.webp`),
    author: { '@type': 'Organization', name: SITE.author, url: `${SITE.url}/sobre-nosotros/` },
    publisher: {
      '@type': 'Organization', name: SITE.name, url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
    },
    isAccessibleForFree: true,
    articleSection: cat.label,
    about: { '@type': 'VideoGame', name: 'Grand Theft Auto VI' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: cat.label, item: `${SITE.url}/${d.category}/` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} image={d.image ?? `/img/portadas/${d.category}.webp`} type="article" jsonLd={jsonLd} published={d.date} modified={d.updated ?? d.date} section={cat.label}>
  <article class="post" data-pagefind-body>
    <nav class="breadcrumbs" data-pagefind-ignore><a href="/">Inicio</a> › <a href={`/${d.category}/`}>{cat.label}</a></nav>
    <header>
      <a class="tag" href={`/${d.category}/`}>{cat.label}</a>
      {d.rumor && <span class="tag rumor">Rumor</span>}
      {d.pilar && <span class="tag vivo">Guía actualizada</span>}
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
      <p class="meta muted small">
        Por <a href="/sobre-nosotros/" rel="author">{SITE.author}</a> ·
        {d.pilar
          ? <>Actualizado el <time datetime={(d.updated ?? d.date).toISOString()}>{formatDate(d.updated ?? d.date)}</time></>
          : <>
              <time datetime={d.date.toISOString()} data-rel>{d.category === 'noticias' ? formatDateTime(d.date) : formatDate(d.date)}</time>
              {d.updated && d.updated.getTime() - d.date.getTime() > 36e5 && <> · Actualizado el <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
            </>}
        · {readingTime(post.body ?? '')} min de lectura
      </p>
    </header>
    <figure class="hero">
      <img data-pagefind-meta="image[src]" fetchpriority="high" decoding="async" src={d.image ?? `/img/portadas/${d.category}.webp`} srcset={srcset(d.image ?? `/img/portadas/${d.category}.webp`)} sizes="(max-width: 800px) 100vw, 760px" alt={d.image ? (d.imageAlt ?? '') : ''} width="1200" height="675" />
      {d.image && d.imageCredit && <figcaption class="credit">Imagen: {d.imageCredit}</figcaption>}
    </figure>
    {d.rumor && (
      <p class="rumor-note"><strong>Información sin confirmar.</strong> Este artículo trata sobre rumores o filtraciones que Rockstar Games no ha confirmado oficialmente. Puede que no sean ciertos.</p>
    )}
    <AdSlot />
    {d.cuentaAtras && <HoraLocal />}
    <div class="prose"><Content /></div>
    <Compras items={d.compras} />
    <Compartir url={url} title={d.title} />

    {d.sources.length > 0 && (
      <aside class="sources">
        <strong>Fuentes</strong>
        <ul>{d.sources.map((s: any) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></li>)}</ul>
      </aside>
    )}
    {d.tags.length > 0 && <p class="tags">{d.tags.map((t: string) => <span class="tag">#{t}</span>)}</p>}
    <Siguenos />
    <AdSlot />
  </article>

  {related.length > 0 && (
    <section class="related">
      <h2>También te puede interesar</h2>
      <div class="grid">{related.map((p: any) => <PostCard post={p} />)}</div>
    </section>
  )}
</Base>
<style>
  .meta a { color: inherit; text-decoration: underline; text-decoration-color: #ffffff33; text-underline-offset: 3px; }
  .post { max-width: 760px; }
  h1 { font-size: clamp(2rem, 6vw, 3.2rem); margin: 12px 0 10px; }
  .lead { font-size: 1.2rem; color: var(--muted); margin: 0 0 10px; }
  .hero { margin: 20px 0 0; }
  .hero img { border-radius: var(--radius); width: 100%; display: block; }
  .tag.vivo { background: #5dff8a22; color: var(--leaf); margin-left: 4px; }
  .rumor-note { border: 1px solid var(--orange); background: #ff9a3d14; border-radius: var(--radius); padding: 12px 16px; font-size: .95rem; margin-top: 20px; }
  .sources { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; margin-top: 32px; font-size: .95rem; }
  .sources ul { margin: 6px 0 0; padding-left: 18px; }
  .tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 20px; }
  .related { margin-top: 56px; }
  .related h2 { font-size: 1.8rem; }
</style>
